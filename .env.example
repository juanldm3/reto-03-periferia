# Copia este archivo como .env (no se sube al repositorio) o configura estas variables en Render.

# Proveedor del modelo: anthropic (por defecto) u openai
LLM_PROVIDER=anthropic
# Clave de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Modelo. Por defecto claude-sonnet-5-5
LLM_MODEL=

# Solo si LLM_PROVIDER=openai (LLM_MODEL es obligatorio en ese caso)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Opcional: protege el chat público con una clave que se escribe en la interfaz
APP_ACCESS_KEY=

# Límites de costo y robustez (opcionales)
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
MAX_TOKENS_GLOBAL=3000000
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=60000

PORT=3000
